# ==============================================================================
# AI AGENTS LEARNING WIKI - Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# Never commit real API keys, secrets, or production credentials to version control.
# Copy this file to .env and insert your local development credentials if needed.
# Note: Core Wiki operations (ingest, query, lint) and educational Python examples
# are designed to function fully offline without requiring any paid API keys.
# ==============================================================================

# Optional Model Provider API Keys (for live LLM exploration only)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional Microsoft / Azure Foundry Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_api_key_here

# Optional Observability & Tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
